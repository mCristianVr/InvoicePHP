{% extends 'base.html.twig' %}

{% block title %}Nueva factura{% endblock %}

{% block body %}
<div class="mx-auto max-w-6xl p-4 sm:p-6 lg:p-8">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-teal-700">Facturas</p>
            <h1 class="mt-1 text-3xl font-bold text-slate-900">Generar factura</h1>
            <p class="mt-1 text-sm text-slate-600">Busca cliente por nombre, NIF/NIE/CIF o email, o crealo directamente aqui.</p>
        </div>
        <a class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" href="{{ path('app_dashboard') }}">Volver al panel</a>
    </div>

    {% for message in app.flashes('error') %}
        <div class="mb-4 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700 shadow-sm">{{ message }}</div>
    {% endfor %}

    <div class="rounded-3xl border border-emerald-100 bg-white/90 p-6 shadow-[0_20px_60px_rgba(6,78,59,0.12)] sm:p-8">
        {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}
            <section class="space-y-4 rounded-2xl border border-emerald-100/80 bg-emerald-50/40 p-4">
                <h2 class="text-base font-semibold text-slate-900">Cliente</h2>

                <div class="grid gap-4 sm:grid-cols-2">
                    <div id="existing-customer-field" class="customer-autocomplete {% if form.createNewCustomer.vars.checked %}hidden{% endif %}">
                        {{ form_label(form.customer, null, {'label_attr': {'class': 'mb-2 block text-sm font-semibold text-slate-700'}}) }}
                        {{ form_widget(form.customer, {'attr': {'class': 'w-full rounded-2xl border border-emerald-100 bg-white px-3.5 py-3 text-slate-900 shadow-sm outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100'}}) }}
                        <p class="mt-1 text-xs text-slate-500">Escribe para filtrar por nombre, ID, NIF/CIF o email.</p>
                        {{ form_errors(form.customer) }}
                    </div>
                    <div>
                        <p class="mb-2 block text-sm font-semibold text-slate-700">Fecha de emision</p>
                        <div class="w-full rounded-2xl border border-slate-200 bg-slate-100 px-3.5 py-3 text-slate-700">{{ invoiceDate|date('d/m/Y') }}</div>
                        <p class="mt-1 text-xs text-slate-500">Se fija automaticamente al dia de emision y no es editable.</p>
                        {% if customersCount == 0 %}
                            <p class="mt-1 text-xs font-medium text-amber-700">No tienes clientes guardados todavia. Marca la opcion de crear cliente nuevo.</p>
                        {% endif %}
                    </div>
                </div>


                <div class="rounded-2xl border border-slate-200 bg-white p-4">
                    <div class="mb-3 flex items-center gap-2">
                        {{ form_widget(form.createNewCustomer, {'attr': {'class': 'h-4 w-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-200'}}) }}
                        {{ form_label(form.createNewCustomer, null, {'label_attr': {'class': 'text-sm font-semibold text-slate-700'}}) }}
                    </div>

                    <div id="inline-customer-fields" class="grid gap-4 sm:grid-cols-3 {% if not form.createNewCustomer.vars.checked %}hidden{% endif %}">
                        <div>
                            {{ form_label(form.newCustomerName, null, {'label_attr': {'class': 'mb-2 block text-sm font-semibold text-slate-700'}}) }}
                            {{ form_widget(form.newCustomerName, {'attr': {'class': 'w-full rounded-xl border border-emerald-100 bg-emerald-50/40 px-3 py-2.5 text-slate-900 outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100', 'placeholder': 'Nombre o razon social'}}) }}
                            {{ form_errors(form.newCustomerName) }}
                        </div>
                        <div>
                            {{ form_label(form.newCustomerNifCif, null, {'label_attr': {'class': 'mb-2 block text-sm font-semibold text-slate-700'}}) }}
                            {{ form_widget(form.newCustomerNifCif, {'attr': {'class': 'w-full rounded-xl border border-emerald-100 bg-emerald-50/40 px-3 py-2.5 uppercase text-slate-900 outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100', 'placeholder': '12345678Z'}}) }}
                            {{ form_errors(form.newCustomerNifCif) }}
                        </div>
                        <div>
                            {{ form_label(form.newCustomerEmail, null, {'label_attr': {'class': 'mb-2 block text-sm font-semibold text-slate-700'}}) }}
                            {{ form_widget(form.newCustomerEmail, {'attr': {'class': 'w-full rounded-xl border border-emerald-100 bg-emerald-50/40 px-3 py-2.5 text-slate-900 outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100', 'placeholder': 'cliente@email.com'}}) }}
                            {{ form_errors(form.newCustomerEmail) }}
                        </div>
                    </div>
                </div>
            </section>

            <section class="space-y-4 rounded-2xl border border-emerald-100/80 bg-cyan-50/40 p-4">
                <div class="flex items-center justify-between gap-3">
                    <h2 class="text-base font-semibold text-slate-900">Conceptos</h2>
                    <button type="button" id="add-line" class="rounded-xl border border-cyan-200 bg-white px-3 py-2 text-sm font-semibold text-cyan-800 transition hover:bg-cyan-50">Anadir linea</button>
                </div>

                <div>
                    {{ form_errors(form.lines) }}
                </div>

                <div id="invoice-lines" data-prototype="{{ form_widget(form.lines.vars.prototype)|e('html_attr') }}" data-index="{{ form.lines|length }}" class="space-y-3">
                    {% for lineForm in form.lines %}
                        <div class="invoice-line rounded-2xl border border-slate-200 bg-white p-4">
                            <div class="mb-3 flex items-center justify-between">
                                <p class="text-sm font-semibold text-slate-700">Linea {{ loop.index }}</p>
                                <button type="button" class="remove-line rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-100">Quitar</button>
                            </div>
                            <div class="grid gap-4 sm:grid-cols-12">
                                <div class="sm:col-span-6">
                                    {{ form_label(lineForm.description, null, {'label_attr': {'class': 'mb-2 block text-sm font-semibold text-slate-700'}}) }}
                                    {{ form_widget(lineForm.description, {'attr': {'class': 'w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-slate-900 outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100'}}) }}
                                    {{ form_errors(lineForm.description) }}
                                </div>
                                <div class="sm:col-span-2">
                                    {{ form_label(lineForm.quantity, null, {'label_attr': {'class': 'mb-2 block text-sm font-semibold text-slate-700'}}) }}
                                    {{ form_widget(lineForm.quantity, {'attr': {'class': 'w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-slate-900 outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100'}}) }}
                                    {{ form_errors(lineForm.quantity) }}
                                </div>
                                <div class="sm:col-span-2">
                                    {{ form_label(lineForm.unitPrice, null, {'label_attr': {'class': 'mb-2 block text-sm font-semibold text-slate-700'}}) }}
                                    {{ form_widget(lineForm.unitPrice, {'attr': {'step': '0.01', 'class': 'w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-slate-900 outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100'}}) }}
                                    {{ form_errors(lineForm.unitPrice) }}
                                </div>
                                <div class="sm:col-span-2">
                                    {{ form_label(lineForm.taxRatePercent, null, {'label_attr': {'class': 'mb-2 block text-sm font-semibold text-slate-700'}}) }}
                                    {{ form_widget(lineForm.taxRatePercent, {'attr': {'step': '0.01', 'class': 'w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-slate-900 outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100'}}) }}
                                    {{ form_errors(lineForm.taxRatePercent) }}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </section>

            <section class="grid gap-4 sm:grid-cols-2">
                <div>
                    {{ form_label(form.jobDate, null, {'label_attr': {'class': 'mb-2 block text-sm font-semibold text-slate-700'}}) }}
                    {{ form_widget(form.jobDate, {'attr': {'class': 'w-full rounded-2xl border border-emerald-100 bg-white px-3.5 py-3 text-slate-900 shadow-sm outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100'}}) }}
                    {{ form_errors(form.jobDate) }}
                </div>
                <div class="flex items-end">
                    <button class="w-full rounded-2xl bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-600 px-4 py-3.5 font-semibold text-white shadow-[0_18px_35px_rgba(13,148,136,0.35)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_22px_40px_rgba(13,148,136,0.4)] focus:outline-none focus:ring-4 focus:ring-emerald-200" type="submit">Crear borrador</button>
                </div>
            </section>
        {{ form_end(form) }}
    </div>
</div>

<script>
(() => {
    const existingCustomerField = document.getElementById('existing-customer-field');
    const createToggle = document.getElementById('{{ form.createNewCustomer.vars.id }}');
    const inlineFields = document.getElementById('inline-customer-fields');
    const addLineButton = document.getElementById('add-line');
    const linesContainer = document.getElementById('invoice-lines');

    if (createToggle && inlineFields) {
        const syncToggle = () => {
            inlineFields.classList.toggle('hidden', !createToggle.checked);
            if (existingCustomerField) {
                existingCustomerField.classList.toggle('hidden', createToggle.checked);
            }
        };

        createToggle.addEventListener('change', syncToggle);
        syncToggle();
    }

    const wireRemoveButtons = () => {
        for (const button of linesContainer.querySelectorAll('.remove-line')) {
            button.onclick = () => {
                const card = button.closest('.invoice-line');
                if (!card) {
                    return;
                }

                if (linesContainer.querySelectorAll('.invoice-line').length <= 1) {
                    return;
                }

                card.remove();
            };
        }
    };

    if (addLineButton && linesContainer) {
        addLineButton.addEventListener('click', () => {
            const index = Number(linesContainer.dataset.index || '0');
            const prototype = linesContainer.dataset.prototype || '';
            const html = prototype.replaceAll('__name__', String(index));

            const wrapper = document.createElement('div');
            wrapper.className = 'invoice-line rounded-2xl border border-slate-200 bg-white p-4';
            wrapper.innerHTML = `
                <div class="mb-3 flex items-center justify-between">
                    <p class="text-sm font-semibold text-slate-700">Linea ${index + 1}</p>
                    <button type="button" class="remove-line rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-100">Quitar</button>
                </div>
                <div class="grid gap-4 sm:grid-cols-12">${html}</div>
            `;

            for (const field of wrapper.querySelectorAll('input')) {
                field.classList.add('w-full', 'rounded-xl', 'border', 'border-slate-200', 'bg-white', 'px-3', 'py-2.5', 'text-slate-900', 'outline-none', 'focus:border-emerald-500', 'focus:ring-4', 'focus:ring-emerald-100');
                if (field.name.endsWith('[unitPrice]') || field.name.endsWith('[taxRatePercent]')) {
                    field.setAttribute('step', '0.01');
                }
            }

            for (const label of wrapper.querySelectorAll('label')) {
                label.classList.add('mb-2', 'block', 'text-sm', 'font-semibold', 'text-slate-700');
            }

            for (const group of wrapper.querySelectorAll('div > div')) {
                const input = group.querySelector('input');
                if (!input) {
                    continue;
                }

                if (input.name.endsWith('[description]')) {
                    group.classList.add('sm:col-span-6');
                } else {
                    group.classList.add('sm:col-span-2');
                }
            }

            linesContainer.appendChild(wrapper);
            linesContainer.dataset.index = String(index + 1);
            wireRemoveButtons();
        });
    }

    wireRemoveButtons();
})();
</script>
{% endblock %}
