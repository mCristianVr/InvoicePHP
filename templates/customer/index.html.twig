{% extends 'base.html.twig' %}

{% block title %}Clientes{% endblock %}

{% block body %}
<div class="mx-auto max-w-7xl p-4 sm:p-6 lg:p-8">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-teal-700">CRM basico</p>
            <h1 class="mt-1 text-3xl font-bold text-slate-900">Clientes</h1>
            <p class="mt-1 text-sm text-slate-600">Gestiona datos fiscales y de contacto para facturar sin errores.</p>
        </div>
        <a class="inline-flex rounded-2xl bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-600 px-4 py-3 text-sm font-semibold text-white shadow-[0_14px_30px_rgba(13,148,136,0.35)] transition hover:-translate-y-0.5 hover:shadow-[0_18px_36px_rgba(13,148,136,0.4)]" href="{{ path('app_customer_new') }}">Nuevo cliente</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="mb-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700 shadow-sm">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="mb-4 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700 shadow-sm">{{ message }}</div>
    {% endfor %}

    <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white/95 shadow-sm">
        <table class="min-w-full text-left text-sm">
            <thead class="bg-slate-100/80">
                <tr>
                    <th class="px-4 py-3">Nombre</th>
                    <th class="px-4 py-3">NIF/CIF</th>
                    <th class="px-4 py-3">Ciudad</th>
                    <th class="px-4 py-3">Email</th>
                    {% if showOwnerColumn %}
                        <th class="px-4 py-3">Propietario</th>
                    {% endif %}
                    <th class="px-4 py-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for customer in customers %}
                    <tr class="border-t border-slate-100">
                        <td class="px-4 py-3 font-semibold text-slate-900">{{ customer.name }}</td>
                        <td class="px-4 py-3 text-slate-700">{{ customer.nifCif }}</td>
                        <td class="px-4 py-3 text-slate-700">{{ customer.city ?? '-' }}</td>
                        <td class="px-4 py-3 text-slate-700">{{ customer.email ?? '-' }}</td>
                        {% if showOwnerColumn %}
                            <td class="px-4 py-3 text-slate-700">{{ customer.owner.userIdentifier }}</td>
                        {% endif %}
                        <td class="px-4 py-3">
                            <div class="flex flex-wrap gap-2">
                                <a class="rounded-lg bg-white px-3 py-1.5 text-xs font-semibold text-teal-700 ring-1 ring-teal-200 transition hover:bg-teal-50" href="{{ path('app_customer_show', {'id': customer.id}) }}">Ver</a>
                                <a class="rounded-lg bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 ring-1 ring-slate-200 transition hover:bg-slate-50" href="{{ path('app_customer_edit', {'id': customer.id}) }}">Editar</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td class="px-4 py-10" colspan="{% if showOwnerColumn %}6{% else %}5{% endif %}">
                            <div class="text-center">
                                <p class="text-base font-semibold text-slate-800">Todavia no has creado clientes.</p>
                                <p class="mt-1 text-sm text-slate-500">Empieza registrando su NIF/CIF para preparar la facturacion.</p>
                                <a class="mt-3 inline-flex rounded-lg bg-slate-900 px-3 py-2 text-sm font-medium text-white hover:bg-slate-800" href="{{ path('app_customer_new') }}">Crear primer cliente</a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
