{% extends 'base.html.twig' %}

{% block title %}Detalle de cliente{% endblock %}

{% block body %}
<div class="mx-auto max-w-4xl p-4 sm:p-6 lg:p-8">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-teal-700">Cliente</p>
            <h1 class="mt-1 text-3xl font-bold text-slate-900">{{ customer.name }}</h1>
            <p class="mt-1 text-sm text-slate-600">NIF/CIF: <span class="font-semibold text-slate-800">{{ customer.nifCif }}</span></p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" href="{{ path('app_customer_index') }}">Volver</a>
            <a class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800" href="{{ path('app_customer_edit', {'id': customer.id}) }}">Editar</a>
        </div>
    </div>

    {% for message in app.flashes('error') %}
        <div class="mb-4 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700 shadow-sm">{{ message }}</div>
    {% endfor %}

    <section class="rounded-3xl border border-slate-200 bg-white/95 p-6 shadow-sm sm:p-8">
        <dl class="grid gap-4 sm:grid-cols-2">
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Direccion</dt>
                <dd class="mt-1 text-sm text-slate-900">{{ customer.address ?? '-' }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Codigo postal</dt>
                <dd class="mt-1 text-sm text-slate-900">{{ customer.postalCode ?? '-' }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Ciudad</dt>
                <dd class="mt-1 text-sm text-slate-900">{{ customer.city ?? '-' }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Provincia</dt>
                <dd class="mt-1 text-sm text-slate-900">{{ customer.province ?? '-' }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Email</dt>
                <dd class="mt-1 text-sm text-slate-900">{{ customer.email ?? '-' }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Telefono</dt>
                <dd class="mt-1 text-sm text-slate-900">{{ customer.phone ?? '-' }}</dd>
            </div>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="sm:col-span-2">
                    <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Propietario</dt>
                    <dd class="mt-1 text-sm text-slate-900">{{ customer.owner.userIdentifier }}</dd>
                </div>
            {% endif %}
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Creado</dt>
                <dd class="mt-1 text-sm text-slate-900">{{ customer.createdAt|date('d/m/Y H:i') }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">Actualizado</dt>
                <dd class="mt-1 text-sm text-slate-900">{{ customer.updatedAt|date('d/m/Y H:i') }}</dd>
            </div>
        </dl>

        <div class="mt-8 border-t border-slate-200 pt-6">
            <p class="text-xs font-semibold uppercase tracking-wide text-rose-600">Zona delicada</p>
            <p class="mt-1 text-sm text-slate-600">Eliminar un cliente es irreversible por ahora.</p>
            <form class="mt-3" method="post" action="{{ path('app_customer_delete', {'id': customer.id}) }}" onsubmit="return confirm('¿Seguro que quieres eliminar este cliente?');">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_customer_' ~ customer.id) }}">
                <button class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700 transition hover:bg-rose-100" type="submit">Eliminar cliente</button>
            </form>
        </div>
    </section>
</div>
{% endblock %}
